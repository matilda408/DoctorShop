# LOG_TO_FILE=true
# LOG_LEVEL="DEBUG"
# LOG_ROTATION="100MB"
# LOG_COMPRESSION="zip"
# LOG_RETENTION="3 days"

# REDIS_HOST="remnashop-redis"
# REDIS_PORT=6379
# REDIS_NAME="0"
REDIS_PASSWORD=

